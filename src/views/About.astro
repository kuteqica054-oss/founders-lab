---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import CtaBand from '../components/CtaBand.astro';
import Rich from '../components/Rich.astro';
import { useDict, type Lang } from '../i18n';
import { path } from '../i18n/routes';
import { breadcrumbLd } from '../lib/schema';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useDict(lang);
const ap = t.aboutPage;
---

<Base lang={lang} page="about" jsonLd={[breadcrumbLd(lang, [{ name: ap.kicker, path: path('about', lang) }])]}>
  <PageHero lang={lang} page="about" kicker={ap.kicker} title={ap.title} sheet={7} />

  <section class="wrap grid gap-12 py-16 sm:py-20 lg:grid-cols-12">
    <div class="space-y-6 text-lg text-ink-2 sm:text-xl lg:col-span-7">
      {ap.paragraphs.map((p, i) => <p class:list={[i === 0 ? 'text-2xl text-ink sm:text-3xl font-display font-semibold leading-tight' : '']}>{p}</p>)}
    </div>
    <div class="lg:col-span-5">
      <!-- PHOTO: team at the bench, 1600 × 2000 px portrait -->
      <PhotoSlot aspect="4/5" note="The team at the bench" size="1600 × 2000 px" label={t.ui.photoSlot} />
    </div>
  </section>

  <section class="bg-mm-soft border-y-2 border-ink" aria-labelledby="v-h">
    <div class="wrap py-16 sm:py-20">
      <h2 id="v-h" class="text-4xl sm:text-5xl">{ap.valuesTitle}</h2>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          ap.values.map((v, i) => (
            <li class="sheet corners p-6" data-reveal style={`--i:${i}`}>
              <span class="mono text-sm text-filament-ink">0{i + 1}</span>
              <h3 class="mt-3 text-2xl">{v.title}</h3>
              <p class="mt-2 text-ink-2">{v.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="wrap grid gap-10 py-16 sm:py-20 md:grid-cols-2">
    <div>
      <h2 class="text-3xl">{ap.teamTitle}</h2>
      <Rich as="p" class="mt-4 text-ink-2" lang={lang} text={ap.team} />
    </div>
    <div>
      <h2 class="text-3xl">{ap.workshopTitle}</h2>
      <Rich as="p" class="mt-4 text-ink-2" lang={lang} text={ap.workshop} />
      <a class="link mt-4 inline-block" href={path('contact', lang)}>{t.nav[6].label} →</a>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
