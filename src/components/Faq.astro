---
/* Native <details> accordion — works without JS, keyboard accessible. */
import { rich, useDict, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useDict(lang);
---

<div class="divide-y divide-ink/25 border-y-2 border-ink">
  {
    t.faq.map((f, i) => (
      <details class="faq group" open={i === 0} name="faq">
        <summary class="flex cursor-pointer list-none items-start gap-4 py-5 pr-1 [&::-webkit-details-marker]:hidden">
          <span class="mono mt-1 w-8 shrink-0 text-sm text-ink-3">Q{String(i + 1).padStart(2, '0')}</span>
          <span class="flex-1 font-display text-xl font-bold sm:text-2xl">{f.q}</span>
          <span class="mt-1 grid h-8 w-8 shrink-0 place-items-center border-[1.5px] border-ink group-open:bg-filament" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" class="transition-transform group-open:rotate-45"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.8" /></svg>
          </span>
        </summary>
        <div class="pb-6 pl-12 text-ink-2 sm:max-w-3xl">
          <p set:html={rich(f.a, lang)} />
        </div>
      </details>
    ))
  }
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .faq::details-content {
      transition:
        height 0.3s ease,
        content-visibility 0.3s allow-discrete;
      height: 0;
      overflow: clip;
    }
    .faq[open]::details-content {
      height: auto;
    }
  }
  :global(html) {
    interpolate-size: allow-keywords;
  }
</style>
