---
/*
  PhotoSlot — a place for a real photo later.

  Usage once you have a photo:
    1. Put the file in  src/assets/photos/  (JPG/WEBP, sizes noted per slot below).
    2. import shot from '../assets/photos/workshop.jpg';
    3. <PhotoSlot src={shot} alt="…" aspect="4/3" />
  Astro's <Image> will generate optimised WebP/AVIF in responsive sizes.

  Without `src`, a dashed drawing-frame placeholder is shown (or nothing),
  depending on `photoPlaceholders` in site.config.mjs.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import config from '../../site.config.mjs';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** CSS aspect-ratio, e.g. "4/3", "16/9", "1/1" */
  aspect?: string;
  /** What photo belongs here and at which size — shown in the placeholder. */
  note: string;
  /** Recommended source size, e.g. "1600 × 1200 px" */
  size?: string;
  label?: string;
  class?: string;
}
const { src, alt = '', aspect = '4/3', note, size = '1600 × 1200 px', label = 'Photo', class: cls = '' } = Astro.props;
const mode = config.photoPlaceholders;
const showPlaceholder = !src && (mode === 'always' || (mode === 'dev' && import.meta.env.DEV));
---

{
  src ? (
    <figure class:list={['overflow-hidden border border-ink/80 bg-sheet', cls]} style={`aspect-ratio:${aspect}`}>
      <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" class="h-full w-full object-cover" />
    </figure>
  ) : (
    showPlaceholder && (
      <figure
        class:list={['relative grid place-items-center border-2 border-dashed border-grid-strong bg-mm-soft p-5 text-center', cls]}
        style={`aspect-ratio:${aspect}`}
        data-todo
      >
        <svg class="absolute inset-0 h-full w-full text-grid-strong" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 100 100">
          <path d="M0 0 100 100M100 0 0 100" stroke="currentColor" stroke-width="0.3" vector-effect="non-scaling-stroke" />
        </svg>
        <figcaption class="relative max-w-xs bg-paper/90 px-3 py-2">
          <span class="todo-chip">TODO · {label}</span>
          <span class="label mt-2 block text-ink-2">{note}</span>
          <span class="label mt-1 block">{size}</span>
        </figcaption>
      </figure>
    )
  )
}
