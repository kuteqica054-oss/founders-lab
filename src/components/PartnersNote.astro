---
import Rich from './Rich.astro';
import { useDict, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = useDict(lang).equipmentSpecs.partners;
---

<aside class="grid gap-5 border-2 border-dashed border-ink/50 p-5 sm:p-6 md:grid-cols-[1fr_1.2fr]" data-reveal>
  <div>
    <p class="mono text-sm font-medium text-filament-ink">↗ {p.title}</p>
    <p class="mt-2 text-ink-2">{p.body}</p>
  </div>
  <div>
    <ul class="mono grid gap-2 text-sm sm:grid-cols-2">
      {p.items.map((i) => <li class="border border-ink/25 bg-paper px-3 py-2">{i}</li>)}
    </ul>
    <Rich as="p" class="mt-3 text-sm" lang={lang} text={p.todo} />
  </div>
</aside>
