---
import config from '../../site.config.mjs';
interface Props {
  class?: string;
  size?: 'sm' | 'lg';
}
const { class: cls = '', size = 'sm' } = Astro.props;
const parts = config.brand.name.split(/\s+/);
const last = parts.length > 1 ? parts.pop() : '';
---

<!-- Wordmark built from type: first word(s) in display, last word in a mono "tag" like a part label -->
<span class:list={['inline-flex items-center gap-1.5 whitespace-nowrap', cls]}>
  <svg
    viewBox="0 0 24 24"
    class={size === 'lg' ? 'h-9 w-9' : 'h-6 w-6'}
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
  >
    <circle cx="12" cy="12" r="6.5"></circle>
    <path d="M12 1.5v6M12 16.5v6M1.5 12h6M16.5 12h6"></path>
    <circle cx="12" cy="12" r="2" fill="var(--color-filament)" stroke="none"></circle>
  </svg>
  <span
    class:list={['font-display font-extrabold tracking-tight', size === 'lg' ? 'text-4xl' : 'text-[1.35rem]']}
    style="font-variation-settings:'wdth' 85"
  >
    {parts.join(' ')}
  </span>
  {
    last && (
      <span
        class:list={[
          'mono rounded-[2px] border-[1.5px] border-current px-1.5 font-medium leading-none',
          size === 'lg' ? 'py-1.5 text-2xl' : 'py-1 text-[0.95rem]',
        ]}
      >
        {last}
      </span>
    )
  }
</span>
