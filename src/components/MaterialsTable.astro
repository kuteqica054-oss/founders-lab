---
import { useDict, type Lang } from '../i18n';
interface Props {
  lang: Lang;
  limit?: number;
}
const { lang, limit } = Astro.props;
const m = useDict(lang).materials;
const rows = limit ? m.rows.slice(0, limit) : m.rows;
---

<div class="border-2 border-ink bg-sheet">
  <!-- table on md+, stacked cards on mobile (same markup, no horizontal scroll) -->
  <table class="w-full border-collapse text-left text-[0.95rem]">
    <thead class="hidden md:table-header-group">
      <tr class="bg-ink text-paper">
        {m.cols.map((c) => <th scope="col" class="mono px-4 py-3 text-sm font-medium">{c}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr class="block border-b border-grid-strong px-4 py-4 last:border-b-0 md:table-row md:p-0">
            <th scope="row" class="block font-display text-xl font-bold md:table-cell md:px-4 md:py-4 md:align-top md:text-lg">
              {r.name}
            </th>
            <td class="block pt-1 text-ink-2 md:table-cell md:px-4 md:py-4 md:align-top">
              <span class="label md:hidden">{m.cols[1]}: </span>
              {r.props}
            </td>
            <td class="block pt-2 md:table-cell md:px-4 md:py-4 md:align-top">
              <span class="label md:hidden">{m.cols[2]}: </span>
              {r.use}
            </td>
            <td class="mono block pt-2 text-sm text-blueprint md:table-cell md:px-4 md:py-4 md:align-top">
              <span class="label md:hidden">{m.cols[3]}: </span>
              {r.tool}
            </td>
            <td class="block pt-2 md:table-cell md:px-4 md:py-4 md:align-top">
              <span class="label md:hidden">{m.cols[4]}: </span>
              {r.stock}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="mt-4 flex gap-3 text-sm text-ink-2">
  <span class="mono shrink-0 font-medium text-filament-ink">!</span>
  {m.note}
</p>
