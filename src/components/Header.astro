---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { useDict, type Lang, type RouteKey } from '../i18n';
import { path } from '../i18n/routes';
import config from '../../site.config.mjs';
interface Props {
  lang: Lang;
  page: RouteKey;
}
const { lang, page } = Astro.props;
const t = useDict(lang);
---

<header class="sticky top-0 z-40 border-b border-ink/15 bg-paper/95 backdrop-blur-[2px]">
  <div class="wrap flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
    <a href={path('home', lang)} class="text-ink no-underline" aria-label={`${config.brand.name} — ${t.ui.backHome}`}>
      <Wordmark />
    </a>

    <nav aria-label={t.ui.mainNav} class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {
          t.nav.map((n) => (
            <li>
              <a
                href={path(n.key as RouteKey, lang)}
                aria-current={page === n.key ? 'page' : undefined}
                class="mono relative px-3 py-2 text-[0.9rem] text-ink-2 no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-3 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:h-0.5 aria-[current=page]:after:bg-filament"
              >
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href={path('contact', lang)} class="btn btn-primary hidden min-h-10 px-4 py-2 text-sm md:inline-flex">
        {t.ui.cta}
      </a>
      <button
        type="button"
        class="btn btn-ghost min-h-10 px-3 py-2 text-sm xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <Icon name="menu" size={18} class="menu-open" />
        <Icon name="x" size={18} class="menu-close hidden" />
        <span data-menu-label data-open={t.ui.menu} data-close={t.ui.close}>{t.ui.menu}</span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-ink/15 bg-paper xl:hidden" data-menu>
    <nav aria-label={t.ui.mainNav} class="wrap py-4">
      <ol class="divide-y divide-ink/10">
        {
          t.nav.map((n, i) => (
            <li>
              <a
                href={path(n.key as RouteKey, lang)}
                aria-current={page === n.key ? 'page' : undefined}
                class="flex items-baseline gap-4 py-3 no-underline aria-[current=page]:text-filament-ink"
              >
                <span class="label w-6">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-display text-2xl font-bold">{n.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="mt-4 border-t border-ink/15 pt-4">
        <a href={path('contact', lang)} class="btn btn-primary">{t.ui.cta}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = btn?.querySelector<HTMLElement>('[data-menu-label]');
  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    btn.querySelector('.menu-open')?.classList.toggle('hidden', open);
    btn.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    if (label) label.textContent = (open ? label.dataset.close : label.dataset.open) ?? '';
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });
  menu?.querySelectorAll('a[href*="#"]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
