---
/* Product label 60 × 40 mm with dimension lines. */
import { fmt } from '../../lib/format';
import type { Lang } from '../../i18n';
interface Props {
  title: string;
  lang: Lang;
  class?: string;
}
const { title, lang, class: cls = '' } = Astro.props;
const f = fmt(lang);
const bars = [3, 1, 2, 1, 1, 3, 1, 2, 2, 1, 3, 1, 1, 2, 1, 3, 2, 1, 1, 2];
let bx = 196;
const barRects = bars.map((w, i) => {
  const r = { x: bx, w: w * 1.6, fill: i % 2 === 0 };
  bx += w * 1.6 + 1.2;
  return r;
});
---

<svg viewBox="0 0 320 220" class={cls} role="img" aria-label={title}>
  <title>{title}</title>
  <rect x="40" y="40" width="240" height="140" rx="10" fill="var(--color-sheet)" stroke="var(--color-ink)" stroke-width="2"></rect>
  <rect x="48" y="48" width="224" height="124" rx="6" fill="none" stroke="var(--color-grid-strong)" stroke-dasharray="3 3"></rect>
  <!-- logo -->
  <g fill="none" stroke="var(--color-filament)" stroke-width="2.4">
    <circle cx="82" cy="84" r="16"></circle>
    <path d="M82 60v10M82 98v10M58 84h10M96 84h10"></path>
  </g>
  <!-- title & text lines -->
  <rect x="112" y="72" width="96" height="10" fill="var(--color-ink)"></rect>
  <rect x="112" y="88" width="64" height="6" fill="var(--color-ink-3)"></rect>
  <g fill="var(--color-ink-3)">
    <rect x="64" y="122" width="110" height="5"></rect>
    <rect x="64" y="134" width="96" height="5"></rect>
    <rect x="64" y="146" width="104" height="5"></rect>
  </g>
  <!-- barcode -->
  {barRects.filter((b) => b.fill).map((b) => <rect x={b.x} y="118" width={b.w} height="36" fill="var(--color-ink)" />)}
  <!-- dims -->
  <g stroke="var(--color-blueprint)" stroke-width="1" fill="none">
    <path d="M40 34 V14 M280 34 V14 M44 22 H276"></path>
    <path d="M286 40 H306 M286 180 H306 M298 44 V176"></path>
    <path d="M44 22 l8 -4 v8Z M276 22 l-8 -4 v8Z M298 44 l-4 8 h8Z M298 176 l-4 -8 h8Z" fill="var(--color-blueprint)"></path>
  </g>
  <g class="mono" font-size="12" fill="var(--color-blueprint)">
    <rect x="132" y="14" width="56" height="16" fill="var(--color-sheet)"></rect>
    <text x="160" y="26" text-anchor="middle">{f.mm(60)}</text>
    <text x="300" y="206" text-anchor="end">{f.mm(40)}</text>
  </g>
</svg>
