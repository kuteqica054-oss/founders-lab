---
import Icon from './Icon.astro';
import { useDict, type Lang } from '../i18n';
import config from '../../site.config.mjs';
interface Props {
  lang: Lang;
  tone?: 'paper' | 'dark';
}
const { lang, tone = 'paper' } = Astro.props;
const t = useDict(lang);
const num = config.contact.whatsapp; // optional — the button is hidden when empty
const text = encodeURIComponent('Hi, I have a product idea.');
const href = num ? `https://wa.me/${num}?text=${text}` : '#';
---

{
  num && (
<a
  href={href}
  class:list={['btn', tone === 'dark' ? 'border-paper text-paper hover:bg-paper hover:text-ink' : 'btn-ghost']}
  target={num ? '_blank' : undefined}
  rel={num ? 'noopener' : undefined}
>
  <Icon name="whatsapp" />
  <span>{t.ui.whatsapp}</span>
</a>
  )
}
