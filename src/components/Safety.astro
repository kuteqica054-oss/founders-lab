---
import Rich from './Rich.astro';
import Icon from './Icon.astro';
import { useDict, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useDict(lang);
const icons = ['lock', 'doc', 'shield'] as const;
---

<ul class="grid gap-6 md:grid-cols-3">
  {
    t.safety.map((s, i) => (
      <li class="relative border-t-2 border-blueprint-line pt-5" data-reveal style={`--i:${i}`}>
        <Icon name={icons[i]} size={34} class="text-filament" />
        <h3 class="mt-4 text-2xl">{s.title}</h3>
        <Rich as="p" class="mt-2 text-blueprint-paper/85" lang={lang} text={s.body} />
      </li>
    ))
  }
</ul>
